<Window x:Class="SOACS.OfflineUpdateBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOACS Offline Update Builder" Width="1440" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1015" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SOACS OFFLINE UPDATE BUILDER" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Verified mission-data packaging for disconnected Windows systems" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="1,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="v0.1.0" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderStatusText" Text="READY" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*" />
                <RowDefinition Height="*" MinHeight="175" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Row="0" Grid.Column="0" Header="1  Source Content">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceFolderTextBox" Height="34" ToolTip="Root folder containing the offline update data" />
                        <Button Grid.Column="1" Content="Browse..." Click="BrowseSource_Click" />
                        <Button Grid.Column="2" Content="Scan Folder" Style="{StaticResource PrimaryButton}" Click="ScanSource_Click" />
                    </Grid>

                    <DataGrid x:Name="ContentGrid" Grid.Row="1" ItemsSource="{Binding DetectedItems}" SelectionMode="Single" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, Mode=TwoWay}" Width="48" />
                            <DataGridTextColumn Header="Category" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="65" IsReadOnly="True" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Assign selected item to:" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                        <ComboBox x:Name="CategoryComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
                        <Button Grid.Column="2" Content="Apply Category" Click="ApplyCategory_Click" />
                        <TextBlock x:Name="ScanSummaryText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="1" Header="2  Deployment Profile and Output">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profile:" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProfileComboBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="ProfileComboBox_SelectionChanged" />
                        <Button Grid.Column="2" Content="Save Paths" Click="SaveProfile_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Review every destination before building. Paths support Windows environment variables." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <DataGrid x:Name="TargetsGrid" Grid.Row="2" ItemsSource="{Binding ActiveTargets}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryId}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="Destination Path" Binding="{Binding DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding CopyMode, Mode=TwoWay}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Package:" VerticalAlignment="Center" />
                        <TextBox x:Name="PackageNameTextBox" Grid.Column="1" Text="MissionDataUpdate" />
                        <TextBlock Grid.Column="2" Text="Version:" VerticalAlignment="Center" Margin="10,0,5,0" />
                        <TextBox x:Name="PackageVersionTextBox" Grid.Column="3" Text="1.0" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output folder:" VerticalAlignment="Center" />
                        <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" />
                        <Button Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" />
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CreateZipCheckBox" Content="Create ZIP package" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" IsEnabled="False" Click="CancelBuild_Click" />
                        <Button x:Name="BuildButton" Grid.Column="2" Content="Build Deployment Package" Style="{StaticResource PrimaryButton}" Click="BuildPackage_Click" />
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="3  Build Activity">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BuildProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Waiting to build" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <TextBox x:Name="ActivityLogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Background="#0B1015" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="FooterStatusText" Text="Select a source folder to begin." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="OFFLINE • VERIFIED • REVERSIBLE" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
