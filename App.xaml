<Application x:Class="SOACS.OfflineUpdateBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111820" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1B2630" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#24313D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B4C59" />
        <SolidColorBrush x:Key="TextBrush" Color="#F0F5F2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AEBBC2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A7D129" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F0B429" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F05252" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F151B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F4F7F5" />
            <Setter Property="Foreground" Value="#152028" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="#18222B" />
            <Setter Property="AlternatingRowBackground" Value="#202D37" />
            <Setter Property="HorizontalGridLinesBrush" Value="#344550" />
            <Setter Property="VerticalGridLinesBrush" Value="#344550" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A3944" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7" />
        </Style>
    </Application.Resources>
</Application>
